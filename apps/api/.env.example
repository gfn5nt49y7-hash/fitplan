# 复制为 .env 后按需修改。本地便携版 PostgreSQL 用 5433 端口
DATABASE_URL="postgresql://fitplan:change-me@127.0.0.1:5433/fitplan?schema=public"
PORT=8787
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# postgres = PostgreSQL（Prisma）；json = 本地 JSON 文件（无需数据库）
# 不设置时：有 DATABASE_URL 就用 postgres，否则用 json
FITPLAN_STORAGE=postgres

# 以下两项仅在 FITPLAN_STORAGE=json 时生效
FITPLAN_DATA_FILE=.data/fitplan-store.json
# Set to off only for throwaway tests.
FITPLAN_PERSISTENCE=on
